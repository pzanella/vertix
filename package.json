{
  "name": "vertix",
  "description": "Turn 16:9 video into 9:16 in the browser — Rust/WASM face detection finds speakers and frames them automatically, with no upload and no server.",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "build:wasm": "cd wasm && wasm-pack build --target web --out-dir ../src/core/wasm",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shaka-player": "^5.2.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "postcss": "^8.4.49",
    "prettier": "^3.9.8",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.0.0"
  }
}
